# ──────────────────────────────────────────────────────────────
# Banco de dados (PostgreSQL)
# ──────────────────────────────────────────────────────────────
# Exemplo local:  postgresql://postgres:postgres@localhost:5432/linkly?schema=public
# Em produção use a connection string do seu provedor (Neon, Supabase, Railway...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkly?schema=public"

# ──────────────────────────────────────────────────────────────
# Autenticação (NextAuth / Auth.js)
# ──────────────────────────────────────────────────────────────
# Gere um segredo seguro com:  openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"
# Em produção defina a URL pública (https://seu-dominio.com)
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────
# Aplicação
# ──────────────────────────────────────────────────────────────
# URL pública usada para montar o link curto (sem barra no final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────
# Seed (usuário admin inicial)
# ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@linkly.dev"
SEED_ADMIN_PASSWORD="admin123456"
