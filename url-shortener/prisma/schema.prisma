// Prisma schema — Encurtador de Links
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String? // hash bcrypt (nulo para contas OAuth futuras)
  role      Role     @default(USER)
  image     String?
  links     Link[]
  accounts  Account[]
  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Link {
  id             String    @id @default(cuid())
  slug           String    @unique
  originalUrl    String
  active         Boolean   @default(true)
  expirationDate DateTime?
  clicks         Int       @default(0)
  // Dono do link. Nulo = link anônimo/temporário criado por visitante.
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickEvents    Click[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([createdAt])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ip        String?
  city      String?
  country   String?
  browser   String?
  os        String?
  device    String?
  referer   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
}

// ── Tabelas exigidas pelo adapter do Auth.js (sessões/contas OAuth) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
